package parser;

/**
 * OBJETIVO: Ejecutar el análisis sintáctico evaluando secuencialmente el flujo de tokens contra la gramática LALR (BNF) definida en el proyecto.
 * ENTRADAS: Secuencia de tokens (`Symbol`) generados y devueltos uno a uno por el analizador léxico.
 * SALIDAS: Valididad del flujo de tokens; de lo contrario, una lista de errores con coordenadas exactas mediante el modo pánico.
 * RESTRICCIONES: El parser no debe frenar el flujo en el primer error encontrado (salvo que sea un Fatal), y se apoya en producciones 'error'.
 */
import scanner.*;
import java_cup.runtime.*;
import java.util.*;
import tabla.TablaManagement;

parser code {:

    private static final List<String> SYNTAX_ERRORS = new ArrayList<>();
    private TablaManagement tabla = new TablaManagement();

    public TablaManagement getTabla() {
        return tabla;
    }

    public static void resetSyntaxErrors() {
        SYNTAX_ERRORS.clear();
    }

    public static List<String> getSyntaxErrors() {
        return new ArrayList<>(SYNTAX_ERRORS);
    }

    public static void main(String[] args) throws Exception {
        Lexer lexer = new Lexer(new java.io.InputStreamReader(System.in));
        parser p = new parser(lexer);
        try {
            Object result = p.parse();
            System.out.println("Sintaxis correcta");
        } catch (Exception e) {
            System.out.println("Error sintáctico: " + e.getMessage());
        }
    }

    @Override
    public void report_error(String message, Object info) {
        String formatted;
        int line = -1;
        if (info instanceof Symbol) {
            Symbol symbol = (Symbol) info;
            if (symbol.left > 0) line = symbol.left;
        }
        if (line == -1) {
            try {
                java_cup.runtime.Scanner currentScanner = getScanner();
                if (currentScanner instanceof scanner.Lexer) {
                    line = ((scanner.Lexer) currentScanner).getCurrentLine();
                }
            } catch (Exception ex) { }
        }
        if (line > 0) {
            formatted = "Error sintáctico en línea " + line + ": " + message;
        } else {
            formatted = "Error sintáctico: " + message;
        }
        SYNTAX_ERRORS.add(formatted);
        System.err.println(formatted);
    }

    @Override
    public void syntax_error(Symbol cur_token) {
        report_error("token inesperado '" + cur_token.value + "'", cur_token);
    }
:};

/* ===== TERMINALES ===== */
terminal LEX_ERROR;

terminal INT, FLOAT, CHAR, STRING, BOOL, EMPTY, EXPINT_KW, FRAC_KW;
terminal MAIN, IF, ELSE, BREAK, RETURN, CASE, DEFAULT, SWITCH, WHILE, DO;
terminal PAR_I, PAR_D, LLAVE_I, LLAVE_D;
terminal ARR_I, ARR_D, COMMA;
terminal PYC, ASSIGN, SEP, DOSPUNTOS;
terminal PLUS, MINUS, MULT, DIV, MOD, POW;
terminal INC, DEC;
terminal AND, OR, NOT;
terminal EQUAL, N_EQUAL, LESS_T, LESS_TE, GREATER_T, GREATER_TE;
terminal TRUE, FALSE;
terminal String ID, NUM, FRAC_LIT, EXPINT_LIT, STRING_LIT, CHAR_LIT;
terminal CIN, COUT;

/* ===== NO TERMINALES ===== */
non terminal String tipo_retorno;
non terminal String tipo;
non terminal  programa, funciones, funcion;
non terminal  main_proc, bloque, cuerpo_funcion, sentencias, sentencia;
non terminal  condicional, bucle, multi_choice;
non terminal  lista_casos, caso, default_opt;
non terminal  entrada, salida, lista_salida, item_salida;
non terminal  declaracion;
non terminal  declaracion_num, declaracion_scalar, declaracion_num_resto, declaracion_scalar_resto;
non terminal  asignacion, asignacion_array;
non terminal  expresion;
non terminal  expr_logica, expr_conjuncion, expr_negacion;
non terminal  resto_disyuncion, resto_conjuncion;
non terminal  comparacion;
non terminal  expr_igual, expr_n_igual, expr_menor, expr_menor_igual, expr_mayor, expr_mayor_igual;
non terminal  expr_aritmetica, resto_expresion;
non terminal  termino, resto_termino;
non terminal  potencia, resto_potencia;
non terminal  factor;
non terminal  unario, atomo_bool;
non terminal  llamada_funcion, argumentos;
non terminal  parametros, parametro;
non terminal  numero, literal_caso;
non terminal  dimensiones, acceso_array;
non terminal  filas_init, fila_init, lista_valores;

/* ===== PRECEDENCIA Y ASOCIATIVIDAD ===== */
precedence left OR;
precedence left AND;
precedence left EQUAL, N_EQUAL;
precedence left LESS_T, LESS_TE, GREATER_T, GREATER_TE;
precedence left PLUS, MINUS;
precedence left MULT, DIV, MOD;
precedence right POW;
precedence right NOT, INC, DEC;

/* ===== START ===== */
start with programa;

/* ===== PRODUCCIONES ===== */

programa ::= funciones main_proc
           | main_proc
           ;

funciones ::= funciones funcion
            | funcion
            ;

funcion ::= tipo_retorno:t SEP ID:id
            {:
                System.err.println("Reconocida función: " + id);
                tabla.insertar(new tabla.Simbolo(id, t, "funcion", idleft, idright, tabla.getScopeActual()));
                tabla.entrarScope();
            :}
            PAR_I parametros PAR_D cuerpo_funcion
            {: tabla.salirScope(); :}
          ;

tipo_retorno ::= INT    {: RESULT = "int";    :}
               | FLOAT  {: RESULT = "float";  :}
               | CHAR   {: RESULT = "char";   :}
               | STRING {: RESULT = "string"; :}
               | BOOL   {: RESULT = "bool";   :}
               ;

parametros ::= parametros COMMA parametro
             | parametro
             | /* vacío */
             ;

parametro ::= tipo:t SEP ID:id
            {:
                tabla.insertar(new tabla.Simbolo(id, t, "parametro", idleft, idright, tabla.getScopeActual()));
            :}
            ;

main_proc ::= EMPTY SEP MAIN PAR_I PAR_D 
            {:
                tabla.insertar(new tabla.Simbolo("__main__", "empty", "funcion", 0, 0, tabla.getScopeActual()));
                tabla.entrarScope();
            :}
              cuerpo_funcion
            {: tabla.salirScope(); :}
            ;

cuerpo_funcion ::= LLAVE_I error LLAVE_D   /* prioridad para recuperación */
                 | LLAVE_I sentencias LLAVE_D
                 ;

bloque ::= LLAVE_I error LLAVE_D
         | LLAVE_I 
         {: tabla.entrarScope(); :} sentencias LLAVE_D {: tabla.salirScope(); :}
         ;

sentencias ::= sentencias sentencia
             | /* vacío */
             ;

sentencia ::= declaracion
            | asignacion
            | asignacion_array
            | condicional
            | bucle
            | multi_choice
            | BREAK PYC
            | RETURN SEP expresion PYC
            | entrada PYC
            | salida PYC
            | expresion PYC
            | LEX_ERROR:e {: report_error("Token léxico inválido: '" + e + "'", new Symbol(sym.LEX_ERROR, eleft, eright, e)); :}
            | error PYC
            | error LLAVE_D
            ;

declaracion ::= declaracion_num
              | declaracion_scalar
              ;

declaracion_num ::= INT SEP ID:id declaracion_num_resto
{:
    tabla.insertar(new tabla.Simbolo(id, "int", "variable", idleft, idright, tabla.getScopeActual()));
:}
                  | FLOAT SEP ID:id declaracion_num_resto
{:
    tabla.insertar(new tabla.Simbolo(id, "float", "variable", idleft, idright, tabla.getScopeActual()));
:}
                  ;

declaracion_num_resto ::= PYC
                        | ASSIGN expresion PYC
                        | ARR_I NUM ARR_D ARR_I NUM ARR_D PYC
                        | ARR_I NUM ARR_D ARR_I NUM ARR_D ASSIGN LLAVE_I filas_init LLAVE_D PYC
                        ;

declaracion_scalar ::= CHAR SEP ID:id declaracion_scalar_resto
{:
    tabla.insertar(new tabla.Simbolo(id, "char", "variable", idleft, idright, tabla.getScopeActual()));
:}
                     | STRING SEP ID:id declaracion_scalar_resto
{:
    tabla.insertar(new tabla.Simbolo(id, "string", "variable", idleft, idright, tabla.getScopeActual()));
:}
                     | BOOL SEP ID:id declaracion_scalar_resto
{:
    tabla.insertar(new tabla.Simbolo(id, "bool", "variable", idleft, idright, tabla.getScopeActual()));
:}
                     | EXPINT_KW SEP ID:id declaracion_scalar_resto
{:
    tabla.insertar(new tabla.Simbolo(id, "expint", "variable", idleft, idright, tabla.getScopeActual()));
:}
                     | FRAC_KW SEP ID:id declaracion_scalar_resto
{:
    tabla.insertar(new tabla.Simbolo(id, "frac", "variable", idleft, idright, tabla.getScopeActual()));
:}
                     ;

declaracion_scalar_resto ::= PYC
                           | ASSIGN expresion PYC
                           ;

dimensiones ::= ARR_I NUM ARR_D ARR_I NUM ARR_D;

filas_init ::= filas_init COMMA fila_init
             | fila_init
             ;

fila_init ::= LLAVE_I lista_valores LLAVE_D
            | LLAVE_I error LLAVE_D
            ;

lista_valores ::= lista_valores COMMA expr_aritmetica
                | expr_aritmetica
                ;

asignacion ::= ID ASSIGN expresion PYC
             ;

asignacion_array ::= acceso_array ASSIGN expr_aritmetica PYC
                   ;

acceso_array ::= ID ARR_I expr_aritmetica ARR_D ARR_I expr_aritmetica ARR_D
               | ID ARR_I error ARR_D ARR_I error ARR_D
               ;

condicional ::= IF SEP PAR_I expresion PAR_D bloque
              | IF SEP PAR_I expresion PAR_D bloque ELSE SEP bloque
              ;

bucle ::= DO SEP bloque WHILE SEP PAR_I expresion PAR_D PYC
        ;

multi_choice ::= SWITCH SEP PAR_I expresion PAR_D LLAVE_I lista_casos default_opt LLAVE_D
               ;

lista_casos ::= lista_casos caso
              | caso
              ;

caso ::= CASE SEP literal_caso DOSPUNTOS sentencias
       ;

default_opt ::= DEFAULT SEP DOSPUNTOS sentencias
              | /* vacío */
              ;

literal_caso ::= NUM
               | CHAR_LIT
               | TRUE
               | FALSE
               ;

entrada ::= CIN SEP acceso_array
          | CIN SEP ID
          ;

salida ::= COUT SEP lista_salida
         ;

lista_salida ::= lista_salida COMMA item_salida
               | item_salida
               ;

item_salida ::= expresion;

expresion ::= expr_logica
            | STRING_LIT
            ;

expr_logica ::= expr_conjuncion resto_disyuncion;

resto_disyuncion ::= OR expr_conjuncion resto_disyuncion
                   | /* vacío */
                   ;

expr_conjuncion ::= expr_negacion resto_conjuncion;

resto_conjuncion ::= AND expr_negacion resto_conjuncion
                   | /* vacío */
                   ;

expr_negacion ::= NOT expr_negacion
                | comparacion
                ;

comparacion ::= expr_igual
              | expr_n_igual
              | expr_menor
              | expr_menor_igual
              | expr_mayor
              | expr_mayor_igual
              | expr_aritmetica
              | atomo_bool
              ;

expr_igual        ::= EQUAL PAR_I expr_aritmetica COMMA expr_aritmetica PAR_D
                    | EQUAL PAR_I atomo_bool COMMA atomo_bool PAR_D;
expr_n_igual      ::= N_EQUAL PAR_I expr_aritmetica COMMA expr_aritmetica PAR_D
                    | N_EQUAL PAR_I atomo_bool COMMA atomo_bool PAR_D;
expr_menor        ::= LESS_T PAR_I expr_aritmetica COMMA expr_aritmetica PAR_D;
expr_menor_igual  ::= LESS_TE PAR_I expr_aritmetica COMMA expr_aritmetica PAR_D;
expr_mayor        ::= GREATER_T PAR_I expr_aritmetica COMMA expr_aritmetica PAR_D;
expr_mayor_igual  ::= GREATER_TE PAR_I expr_aritmetica COMMA expr_aritmetica PAR_D;

atomo_bool ::= TRUE
             | FALSE
             | PAR_I expr_logica PAR_D
             ;

expr_aritmetica ::= termino resto_expresion;

resto_expresion ::= PLUS termino resto_expresion
                  | MINUS termino resto_expresion
                  | /* vacío */
                  ;

termino ::= potencia resto_termino;

resto_termino ::= MULT potencia resto_termino
                | DIV potencia resto_termino
                | MOD potencia resto_termino
                | /* vacío */
                ;

potencia ::= factor resto_potencia;

resto_potencia ::= POW factor resto_potencia
                 | /* vacío */
                 ;

factor ::= unario
         | numero
         | ID
         | CHAR_LIT
         | acceso_array
         | llamada_funcion
         | PAR_I expr_aritmetica PAR_D
         ;

unario ::= MINUS numero
         | INC ID
         | DEC ID
         ;

numero ::= NUM
         | FRAC_LIT
         | EXPINT_LIT
         ;

llamada_funcion ::= ID PAR_I argumentos PAR_D
                  | ID PAR_I error PAR_D
                  ;

argumentos ::= argumentos COMMA expresion
             | expresion
             | /* vacío */
             ;

tipo ::= INT       {: RESULT = "int";    :}
       | FLOAT     {: RESULT = "float";  :}
       | CHAR      {: RESULT = "char";   :}
       | STRING    {: RESULT = "string"; :}
       | BOOL      {: RESULT = "bool";   :}
       | EXPINT_KW {: RESULT = "expint"; :}
       | FRAC_KW   {: RESULT = "frac";   :}
       ;